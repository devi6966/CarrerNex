# ── Vercel Deployment Environment Variables ─────────────────────────────────

# 1. Backend API URL
# In local development: http://localhost:8000
# In production on Vercel: Set to your deployed FastAPI backend URL (e.g. Render / Railway / Fly.io)
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com

# 2. NextAuth Authentication Secret
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# 3. NextAuth URL
# In local: http://localhost:3000
# In production on Vercel: Your Vercel deployment URL
AUTH_URL=https://your-project.vercel.app

# 4. Google OAuth (Optional - For Google One-Click Sign-in)
# Obtain from Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here
